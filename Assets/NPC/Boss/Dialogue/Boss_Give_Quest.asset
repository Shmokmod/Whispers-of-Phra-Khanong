  m_Name: Boss_Give_Quest
  m_EditorClassIdentifier: Assembly-CSharp::NPCdialogue
  npcName: "\u0E17\u0E48\u0E32\u0E19\u0E11\u0E39\u0E15"
  npcPortrait: {fileID: 0}
  leftPortrait: {fileID: 21300000, guid: 34578732b77c10a48b64521a64192784, type: 3}
  rightPortrait: {fileID: 21300000, guid: 3778434aa7bc39e48b914a4f6cd6d5e1, type: 3}
  dialogueLines:
  - "\u0E17\u0E48\u0E32\u0E19\u0E40\u0E23\u0E35\u0E22\u0E01\u0E02\u0E49\u0E32\u0E21\u0E32\u0E40\u0E1E\u0E23\u0E32\u0E30\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E42\u0E08\u0E23\u0E43\u0E0A\u0E48\u0E44\u0E2B\u0E21"
  - "\u0E43\u0E0A\u0E48 \u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E19\u0E35\u0E49\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E02\u0E49\u0E32\u0E2B\u0E07\u0E38\u0E14\u0E2B\u0E07\u0E34\u0E14\u0E19\u0E31\u0E01"
  - "\u0E02\u0E2D\u0E07\u0E2A\u0E33\u0E04\u0E31\u0E0D\u0E02\u0E2D\u0E07\u0E2A\u0E16\u0E32\u0E19\u0E11\u0E39\u0E15\u0E16\u0E39\u0E01\u0E02\u0E42\u0E21\u0E22\u0E44\u0E1B"
  - "\u0E21\u0E31\u0E19\u0E01\u0E23\u0E30\u0E17\u0E1A\u0E28\u0E31\u0E01\u0E14\u0E34\u0E4C\u0E28\u0E23\u0E35\u0E41\u0E25\u0E30\u0E04\u0E27\u0E32\u0E21\u0E1B\u0E25\u0E2D\u0E14\u0E20\u0E31\u0E22"
  - "\u0E17\u0E48\u0E32\u0E19\u0E21\u0E35\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E2D\u0E30\u0E44\u0E23\u0E1A\u0E49\u0E32\u0E07?"
  - "--\u0E21\u0E35\u0E2B\u0E25\u0E31\u0E01\u0E10\u0E32\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E1A\u0E49\u0E32\u0E07?--"
  - "\u0E44\u0E1B\u0E14\u0E39\u0E17\u0E35\u0E48\u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E0B\u0E1F"
  - "\u0E23\u0E48\u0E2D\u0E07\u0E23\u0E2D\u0E22\u0E22\u0E31\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E04\u0E23\u0E1A"
  - "\u0E02\u0E49\u0E32\u0E2A\u0E31\u0E48\u0E07\u0E2B\u0E49\u0E32\u0E21\u0E43\u0E04\u0E23\u0E41\u0E15\u0E30\u0E15\u0E49\u0E2D\u0E07"
  - "\u0E02\u0E49\u0E32\u0E08\u0E30\u0E44\u0E1B\u0E15\u0E23\u0E27\u0E08\u0E17\u0E31\u0E19\u0E17\u0E35"
  - "\u0E17\u0E48\u0E32\u0E19\u0E21\u0E35\u0E35\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E2D\u0E30\u0E44\u0E23\u0E2D\u0E35\u0E01\u0E44\u0E2B\u0E21?"
  - "-\u0E21\u0E35\u0E1E\u0E22\u0E32\u0E19\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E2B\u0E15\u0E38\u0E01\u0E32\u0E23\u0E13\u0E4C\u0E44\u0E2B\u0E21"
  - "\u0E21\u0E35\u0E04\u0E19\u0E40\u0E1D\u0E49\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E04\u0E37\u0E19\u0E19\u0E31\u0E49\u0E19"
  - "\u0E40\u0E02\u0E32\u0E16\u0E39\u0E01\u0E42\u0E08\u0E21\u0E15\u0E35\u0E41\u0E25\u0E30\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E1A\u0E32\u0E14\u0E40\u0E08\u0E47\u0E1A"
  - "\u0E40\u0E02\u0E32\u0E2D\u0E32\u0E08\u0E08\u0E30\u0E21\u0E35\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C\u0E01\u0E31\u0E1A\u0E40\u0E08\u0E49\u0E32"
  - "\u0E23\u0E31\u0E1A\u0E17\u0E23\u0E32\u0E1A"
  - "--\u0E21\u0E35\u0E1E\u0E22\u0E32\u0E19\u0E40\u0E2B\u0E47\u0E19\u0E40\u0E2B\u0E15\u0E38\u0E01\u0E32\u0E23\u0E13\u0E4C\u0E44\u0E2B\u0E21?--"
  - "\u0E21\u0E35\u0E04\u0E19\u0E40\u0E1D\u0E49\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E04\u0E37\u0E19\u0E19\u0E31\u0E49\u0E19"
  - "\u0E40\u0E02\u0E32\u0E16\u0E39\u0E01\u0E42\u0E08\u0E21\u0E15\u0E35\u0E41\u0E25\u0E30\u0E44\u0E14\u0E49\u0E23\u0E31\u0E1A\u0E1A\u0E32\u0E14\u0E40\u0E08\u0E47\u0E1A"
  - "\u0E40\u0E02\u0E32\u0E2D\u0E32\u0E08\u0E08\u0E30\u0E21\u0E35\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E17\u0E35\u0E48\u0E40\u0E1B\u0E47\u0E19\u0E1B\u0E23\u0E30\u0E42\u0E22\u0E0A\u0E19\u0E4C\u0E01\u0E31\u0E1A\u0E40\u0E08\u0E49\u0E32"
  - "\u0E02\u0E49\u0E32\u0E08\u0E30\u0E44\u0E1B\u0E0B\u0E31\u0E01\u0E16\u0E32\u0E21\u0E40\u0E14\u0E35\u0E4B\u0E22\u0E27\u0E19\u0E35\u0E49"
  - "\u0E17\u0E48\u0E32\u0E19\u0E21\u0E35\u0E35\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E2D\u0E30\u0E44\u0E23\u0E2D\u0E35\u0E01\u0E44\u0E2B\u0E21?"
  - "-\u0E21\u0E35\u0E2B\u0E25\u0E31\u0E01\u0E10\u0E32\u0E19\u0E2D\u0E30\u0E44\u0E23\u0E1A\u0E49\u0E32\u0E07?"
  - "\u0E44\u0E1B\u0E14\u0E39\u0E17\u0E35\u0E48\u0E2B\u0E49\u0E2D\u0E07\u0E40\u0E0B\u0E1F"
  - "\u0E23\u0E48\u0E2D\u0E07\u0E23\u0E2D\u0E22\u0E22\u0E31\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E04\u0E23\u0E1A"
  - "\u0E02\u0E49\u0E32\u0E2A\u0E31\u0E48\u0E07\u0E2B\u0E49\u0E32\u0E21\u0E43\u0E04\u0E23\u0E41\u0E15\u0E30\u0E15\u0E49\u0E2D\u0E07"
  - "\u0E23\u0E31\u0E1A\u0E17\u0E23\u0E32\u0E1A"
  - "--\u0E08\u0E1A--"
  - "\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E02\u0E2D\u0E23\u0E31\u0E1A\u0E17\u0E48\u0E32\u0E19\u0E11\u0E39\u0E15\u0E02\u0E49\u0E32\u0E08\u0E30\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E14\u0E35\u0E17\u0E35\u0E48\u0E2A\u0E38\u0E14"
  speakerPerLine: 0200000001000000010000000100000002000000000000000100000001000000010000000200000002000000000000000100000001000000010000000200000000000000010000000100000001000000020000000200000000000000010000000100000001000000020000000000000002000000
