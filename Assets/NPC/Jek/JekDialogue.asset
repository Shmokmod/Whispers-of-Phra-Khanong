  m_EditorClassIdentifier: Assembly-CSharp::NPCdialogue
  npcName: "\u0E40\u0E08\u0E47\u0E04"
  npcPortrait: {fileID: 0}
  leftPortrait: {fileID: 21300000, guid: 0eac26cd5890a4f4c8a3a4132cc3711d, type: 3}
  rightPortrait: {fileID: 21300000, guid: 3778434aa7bc39e48b914a4f6cd6d5e1, type: 3}
  dialogueLines:
  - "\u0E2A\u0E27\u0E31\u0E2A\u0E14\u0E35\u0E02\u0E2D\u0E23\u0E31\u0E1A"
  - "\u0E17\u0E33\u0E44\u0E21\u0E17\u0E48\u0E32\u0E19\u0E16\u0E36\u0E07\u0E44\u0E14\u0E49\u0E40\u0E14\u0E34\u0E19\u0E21\u0E32\u0E2D\u0E22\u0E39\u0E48\u0E41\u0E16\u0E27\u0E19\u0E35\u0E49"
  - "\u0E17\u0E48\u0E32\u0E19\u0E2B\u0E25\u0E07\u0E17\u0E32\u0E07\u0E21\u0E32\u0E23\u0E36?"
  - "\u0E40\u0E2D\u0E48\u0E2D\u0E40\u0E1B\u0E25\u0E48\u0E32\u0E2B\u0E23\u0E2D\u0E01\u0E17\u0E35\u0E48\u0E08\u0E23\u0E34\u0E07\u0E41\u0E25\u0E49\u0E27\u0E02\u0E49\u0E32"
  - "\u0E2D\u0E22\u0E32\u0E01\u0E44\u0E14\u0E49\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E08\u0E32\u0E01\u0E40\u0E08\u0E49\u0E32\u0E21\u0E32\u0E01\u0E01\u0E27\u0E48\u0E32"
  - "\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E2B\u0E23\u0E2D? \u0E40\u0E08\u0E49\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E43\u0E04\u0E23?"
  - "\u0E02\u0E49\u0E32\u0E40\u0E1B\u0E47\u0E19\u0E19\u0E31\u0E01\u0E2A\u0E37\u0E1A\u0E02\u0E2D\u0E07\u0E17\u0E48\u0E32\u0E19\u0E11\u0E39\u0E15\u0E19\u0E48\u0E30"
  - "\u0E19\u0E31\u0E01\u0E2A\u0E37\u0E1A\u0E02\u0E2D\u0E07\u0E17\u0E48\u0E32\u0E19\u0E11\u0E39\u0E15\u0E2B\u0E23\u0E2D?"
  - "\u0E41\u0E25\u0E49\u0E27\u0E17\u0E48\u0E32\u0E19\u0E21\u0E35\u0E18\u0E38\u0E23\u0E30\u0E2D\u0E30\u0E44\u0E23\u0E41\u0E16\u0E27\u0E19\u0E35\u0E49\u0E2B\u0E23\u0E2D\u0E02\u0E2D\u0E23\u0E31\u0E1A"
  - "\u0E02\u0E49\u0E32\u0E2D\u0E22\u0E32\u0E01\u0E17\u0E23\u0E32\u0E1A\u0E27\u0E48\u0E32\u0E40\u0E08\u0E49\u0E32\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E1E\u0E48\u0E2D\u0E04\u0E49\u0E32\u0E17\u0E35\u0E48\u0E0A\u0E37\u0E48\u0E2D
    \u0E2D\u0E34\u0E19 \u0E2B\u0E23\u0E37\u0E2D\u0E44\u0E21\u0E48?"
  - "\u0E17\u0E48\u0E32\u0E19\u0E2D\u0E34\u0E19\u0E2B\u0E23\u0E2D\u0E2D\u0E37\u0E21\u0E21..."
  - "\u0E02\u0E49\u0E32\u0E23\u0E39\u0E49\u0E08\u0E31\u0E01\u0E40\u0E02\u0E32\u0E41\u0E15\u0E48\u0E02\u0E49\u0E32\u0E19\u0E48\u0E30"
  - "\u0E44\u0E21\u0E48\u0E04\u0E48\u0E2D\u0E22\u0E16\u0E39\u0E01\u0E04\u0E2D\u0E01\u0E31\u0E1A\u0E40\u0E02\u0E32\u0E40\u0E17\u0E48\u0E32\u0E44\u0E2B\u0E23\u0E48\u0E40\u0E25\u0E22\u0E19\u0E48\u0E30\u0E2A\u0E34"
  - "\u0E1A\u0E17\u0E1E\u0E39\u0E14\u0E46"
  - "\u0E1A\u0E17\u0E1E\u0E39\u0E14\u0E46"
  - "\u0E1A\u0E17\u0E1E\u0E39\u0E14\u0E46"
  - "\u0E1A\u0E17\u0E1E\u0E39\u0E14\u0E46"
  - "\u0E1A\u0E17\u0E1E\u0E39\u0E14\u0E46"
  - "\u0E1A\u0E17\u0E1E\u0E39\u0E14\u0E46"
