  m_text: "\u0E01\u0E32\u0E23\u0E02\u0E22\u0E31\u0E1A\u0E43\u0E19 \u0E08\u0E30\u0E43\u0E0A\u0E49\u0E1B\u0E38\u0E48\u0E21
